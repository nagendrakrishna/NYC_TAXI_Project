{
  "datasets": [
    {
      "name": "20d6d0eb",
      "displayName": "Taxi_Analytics",
      "queryLines": [
        "SELECT\r\n",
        "    pickup_date,\r\n",
        "    pickup_hour,\r\n",
        "    pickup_location_id,\r\n",
        "    payment_type,\r\n",
        "    trip_count,\r\n",
        "    total_amount_usd,\r\n",
        "    fare_amount_usd,\r\n",
        "    tip_amount_usd,\r\n",
        "    total_distance_miles,\r\n",
        "    total_duration_seconds\r\n",
        "FROM nyc_taxi.gold.trip_activity_summary"
      ],
      "columns": [
        {
          "displayName": "Payment Type Label",
          "description": "Readable payment labels for taxi payment codes.",
          "expression": "CASE WHEN `payment_type` = 0 THEN 'Flex Fare' WHEN `payment_type` = 1 THEN 'Credit Card' WHEN `payment_type` = 2 THEN 'Cash' WHEN `payment_type` = 3 THEN 'No Charge' WHEN `payment_type` = 4 THEN 'Dispute' WHEN `payment_type` = 5 THEN 'Unknown' WHEN `payment_type` = 6 THEN 'Voided Trip' WHEN `payment_type` = -1 THEN 'Missing' ELSE 'Other' END"
        },
        {
          "displayName": "Average Trip Charge USD",
          "description": "Weighted average charge per trip using pre-aggregated trip counts.",
          "expression": "TRY_DIVIDE(SUM(`total_amount_usd`), SUM(`trip_count`))"
        },
        {
          "displayName": "Average Trip Distance Miles",
          "description": "Weighted average trip distance using pre-aggregated trip counts.",
          "expression": "TRY_DIVIDE(SUM(`total_distance_miles`), SUM(`trip_count`))"
        },
        {
          "displayName": "Average Trip Duration Minutes",
          "description": "Weighted average trip duration in minutes using pre-aggregated trip counts.",
          "expression": "TRY_DIVIDE(SUM(`total_duration_seconds`), SUM(`trip_count`)) / 60"
        }
      ],
      "catalog": "nyc_taxi",
      "schema": "gold"
    }
  ],
